generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}
model Usuario {
  id        Int       @id @default(autoincrement())
  nombre    String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  reportes  Reporte[]
}

model Reporte {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String
  latitud     Float
  longitud    Float
}
