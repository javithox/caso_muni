# Variables de Entorno para Producción en EC2
# Copia este archivo a .env y rellena los valores

# ============================================
# BASE DE DATOS (PostgreSQL)
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=valle_de_sol
DB_HOST=base_de_datos
DB_PORT=5432

# ============================================
# BACKEND
# ============================================
NODE_ENV=production
API_PORT=8081
API_HOST=localhost

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_ENV=production

# ============================================
# NOTAS IMPORTANTES
# ============================================
# - Genera una contraseña segura para DB_PASSWORD:
#   openssl rand -base64 32
# - En EC2, API_HOST será la IP pública de la instancia
# - NEXT_PUBLIC_API_URL debe apuntar a la IP/dominio público
